---
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Ruta sin prefijo de idioma, p. ej. '' o 'blog/'. */
  path?: string;
  title?: string;
  description?: string;
}

const { lang, path = '', title, description } = Astro.props;
const t = useT(lang);
const pageTitle = title ? `${title} · Santiago García` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const home = getRelativeLocaleUrl(lang, '');
const canonical = new URL(getRelativeLocaleUrl(lang, path), Astro.site);
const sections = [
  ['inventario', t.nav.inventory],
  ['ordenes', t.nav.orders],
  ['whatsapp', t.nav.whatsapp],
  ['mas-trabajo', t.nav.more],
  ['sobre-mi', t.nav.about],
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(getRelativeLocaleUrl(l, path), Astro.site)} />
      ))
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#11184f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@50..150,100..900&family=Hanken+Grotesk:wght@400;500;700&family=Martian+Mono:wght@400;600&display=swap"
    />
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="top">
      <a class="me" href={home}>Santiago García</a>
      <nav aria-label={t.nav.sections}>
        {sections.map(([id, label]) => <a href={`${home}#${id}`}>{label}</a>)}
        <a href={getRelativeLocaleUrl(lang, 'blog/')}>{t.nav.blog}</a>
      </nav>
      <div class="tools">
        <div class="langs" role="group" aria-label={t.nav.langAria}>
          {
            (Object.entries(languages) as [Lang, string][]).map(([l, label]) => (
              <a
                class:list={['pill', { on: l === lang }]}
                href={getRelativeLocaleUrl(l, path)}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'true' : undefined}
              >
                {label}
              </a>
            ))
          }
        </div>
        <button
          class="pill"
          id="theme"
          type="button"
          aria-label={t.nav.themeAria}
          data-to-dark={t.nav.themeToDark}
          data-to-light={t.nav.themeToLight}
        >
          {t.nav.themeToDark}
        </button>
      </div>
      <div class="progress" id="progress" aria-hidden="true"></div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap foot">
      <span>© {new Date().getFullYear()} Santiago García Londoño</span>
      <span>{t.footer.madeWith}</span>
    </footer>
  </body>
</html>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme') as HTMLButtonElement;
  const syncTheme = () => {
    const dark = root.dataset.theme === 'dark';
    themeBtn.textContent = dark ? themeBtn.dataset.toLight! : themeBtn.dataset.toDark!;
    themeBtn.setAttribute('aria-pressed', String(dark));
  };
  syncTheme();
  themeBtn.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    syncTheme();
  });

  // Barra de progreso tipo código y títulos que se estiran como una etiqueta saliendo de la impresora.
  const progress = document.getElementById('progress')!;
  const heads = [...document.querySelectorAll<HTMLElement>('.band-title')];
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let queued = false;
  function onScroll() {
    queued = false;
    const vh = innerHeight;
    const max = Math.max(root.scrollHeight - vh, 1);
    progress.style.clipPath = `inset(0 ${100 - (scrollY / max) * 100}% 0 0)`;
    if (calm) return;
    for (const h of heads) {
      const r = h.getBoundingClientRect();
      if (r.bottom < -40 || r.top > vh + 40) continue;
      const p = Math.min(Math.max((vh - r.top) / (vh * 0.75), 0), 1);
      h.style.setProperty('--w', (72 + p * p * 46).toFixed(1));
    }
  }
  addEventListener(
    'scroll',
    () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(onScroll);
      }
    },
    { passive: true },
  );
  onScroll();
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--topBg);
    color: var(--topFg);
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 56px;
    padding: 6px var(--gutter);
    flex-wrap: wrap;
  }
  .top :focus-visible {
    outline-color: #ffdf00;
  }
  .me {
    font: 800 1.05rem/1 var(--display);
    font-variation-settings: 'wdth' 120;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 20px;
    margin-left: auto;
    flex-wrap: wrap;
  }
  nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 6px 0;
    background: linear-gradient(currentColor, currentColor) left bottom / 0 2px no-repeat;
    transition: background-size 200ms var(--out);
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      background-size: 100% 2px;
    }
  }
  .tools {
    display: flex;
    gap: 6px;
  }
  .langs {
    display: flex;
    gap: 6px;
  }
  .pill {
    appearance: none;
    display: inline-grid;
    place-items: center;
    background: none;
    border: 1.5px solid currentColor;
    color: inherit;
    font: 600 0.72rem/1 var(--code);
    padding: 8px;
    border-radius: 3px;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
  }
  .pill.on {
    background: var(--topFg);
    color: var(--topBg);
  }
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -5px;
    height: 5px;
    background: repeating-linear-gradient(90deg, #ffdf00 0 2px, transparent 2px 5px, #ffdf00 5px 9px, transparent 9px 11px, #ffdf00 11px 12px, transparent 12px 16px);
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
  }
  @media (max-width: 760px) {
    nav {
      display: none;
    }
    .tools {
      margin-left: auto;
    }
  }
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 28px;
    font: 400 0.8rem/1.4 var(--code);
    background: var(--bEnd);
    color: var(--fg);
    max-width: none;
  }
</style>
