---
import { render, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import { useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const t = useT(lang).blog;
const { Content } = await render(post);
const slug = post.id.split('/').slice(1).join('/');
const fmt = new Intl.DateTimeFormat(lang, { dateStyle: 'long' });
---

<Base lang={lang} path={`blog/${slug}/`} title={post.data.title} description={post.data.description}>
  <article class="band post">
    <div class="wrap">
      <a class="back" href={getRelativeLocaleUrl(lang, 'blog/')}>{t.back}</a>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .post {
    --bg: var(--bWa);
    --prev: var(--bHero);
    --h: var(--hWa);
  }
  .back {
    font: 600 0.85rem/1 var(--code);
  }
  h1 {
    margin-top: 28px;
    max-width: 22ch;
    font: 900 clamp(2.2rem, 5vw, 4.4rem) / 0.95 var(--display);
    font-variation-settings: 'wdth' 110;
    color: var(--h);
  }
  time {
    display: block;
    margin-top: 16px;
    font: 400 0.8rem/1 var(--code);
  }
  .prose {
    margin-top: 40px;
    max-width: 68ch;
    display: grid;
    gap: 1.1em;
  }
  .prose :global(h2) {
    font: 800 1.6rem/1.15 var(--display);
    margin-top: 0.8em;
  }
  .prose :global(pre) {
    background: var(--paper);
    color: var(--ink);
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    font: 400 0.85rem/1.5 var(--code);
  }
  .prose :global(code) {
    font-family: var(--code);
    font-size: 0.9em;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.4em;
  }
</style>
