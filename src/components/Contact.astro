---
import { contactLinks, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang).contact;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || contactLinks.web3formsKey;
---

<section class="band end" id="contacto">
  <div class="wrap">
    <h2 class="band-title">{t.title}</h2>
    <div class="grid">
      <div class="copy">
        <p class="big">{t.big}</p>
        <div class="links">
          <a class="btn" href={contactLinks.email}>{t.email}</a>
          <a class="btn" href={contactLinks.whatsapp} target="_blank" rel="noopener">{t.whatsapp}</a>
          <a class="btn" href={contactLinks.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn" href={contactLinks.github} target="_blank" rel="noopener">GitHub</a>
          <a class="btn quiet" href={contactLinks.cv[lang]} download>{t.cv}</a>
        </div>
      </div>
      <form
        id="contactForm"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-key={accessKey}
        data-to={contactLinks.emailAddress}
        data-sending={t.sending}
        data-ok={t.ok}
        data-error={t.error}
        data-fallback={t.mailFallback}
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="Portafolio · nuevo mensaje" />
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
        <div class="two">
          <div class="field">
            <label for="cf-name">{t.name}</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="cf-email">{t.mail}</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="cf-message">{t.message}</label>
          <textarea id="cf-message" name="message" rows="5" required></textarea>
        </div>
        <div class="send">
          <button class="btn" type="submit">{t.send}</button>
          <p class="status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const status = form.querySelector<HTMLElement>('.status')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const label = button.textContent ?? '';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    // Sin clave de Web3Forms: abrir el cliente de correo con el mensaje listo.
    if (!form.dataset.key) {
      const subject = encodeURIComponent(`Portafolio · ${data.get('name')}`);
      const body = encodeURIComponent(`${data.get('message')}\n\n${data.get('name')} · ${data.get('email')}`);
      status.textContent = form.dataset.fallback!;
      location.href = `mailto:${form.dataset.to}?subject=${subject}&body=${body}`;
      return;
    }

    button.disabled = true;
    button.textContent = form.dataset.sending!;
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message);
      status.textContent = form.dataset.ok!;
      form.reset();
    } catch {
      status.textContent = form.dataset.error!;
    } finally {
      button.disabled = false;
      button.textContent = label;
    }
  });
</script>

<style>
  .end {
    --bg: var(--bEnd);
    --prev: var(--bAbout);
    --h: var(--hEnd);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  form {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  .two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 560px) {
    .two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label {
    font: 600 0.72rem/1 var(--code);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  input,
  textarea {
    background: transparent;
    border: 2px solid var(--fg);
    border-radius: 4px;
    color: var(--fg);
    font: 400 1rem var(--body);
    padding: 12px 14px;
    min-height: 48px;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    box-shadow: 4px 4px 0 var(--fg);
  }
  .send {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  .status {
    font-weight: 600;
  }
</style>
