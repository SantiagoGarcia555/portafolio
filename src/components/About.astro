---
import { useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useT(Astro.props.lang).about;
---

<section class="band about" id="sobre-mi">
  <div class="wrap">
    <h2 class="band-title">{t.title}</h2>
    <div class="grid">
      <div class="copy">
        <p class="big">{t.big}</p>
        <p>{t.body}</p>
      </div>
      <div class="label">
        <h3>{t.labelTitle}</h3>
        <p>{t.ingredients}</p>
        {
          t.rows.map(([k, v]) => (
            <p>
              <strong>{k}</strong> {v}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    --bg: var(--bAbout);
    --prev: var(--bMore);
    --h: var(--hAbout);
  }
  .label {
    border: 3px solid var(--fg);
    padding: clamp(16px, 2.4vw, 28px);
    max-width: 66ch;
    min-width: 0;
  }
  h3 {
    font: 900 clamp(1.5rem, 3vw, 2.5rem) / 1 var(--display);
    font-variation-settings: 'wdth' 110;
    padding-bottom: 10px;
    border-bottom: 9px solid var(--fg);
  }
  .label p {
    padding-block: 10px;
    border-bottom: 1.5px solid var(--fg);
  }
  .label p:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
</style>
