---
import { useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useT(Astro.props.lang).whatsapp;
---

<section class="band wa" id="whatsapp">
  <div class="wrap">
    <h2 class="band-title">{t.title}</h2>
    <div class="grid">
      <div class="copy">
        <p class="big">{t.big}</p>
        <p>{t.body}</p>
        <dl class="facts">
          {
            t.facts.map(([dt, dd]) => (
              <div>
                <dt>{dt}</dt>
                <dd>{dd}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="phone paper on-paper" id="chat">
        <div class="phone-top">
          <b>{t.phoneTitle}</b>
          <span class="tag">{t.madeUp}</span>
        </div>
        <ol class="msgs">
          {
            t.msgs.map((m, i) => (
              <li class:list={['bub', m.from, { file: m.file }]} style={`--d:${0.3 + i * 0.8}s`}>
                {m.file && <span class="clip" aria-hidden="true">PDF</span>}
                {m.text}
              </li>
            ))
          }
        </ol>
        <div class="phone-foot">
          <button class="btn" type="button" data-replay>{t.replay}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const chat = document.getElementById('chat')!;
  const list = chat.querySelector('.msgs')!;
  const play = () => {
    list.classList.remove('play');
    void (list as HTMLElement).offsetWidth;
    list.classList.add('play');
  };
  new IntersectionObserver(
    ([entry], obs) => {
      if (!entry.isIntersecting) return;
      obs.disconnect();
      play();
    },
    { threshold: 0.35 },
  ).observe(chat);
  chat.querySelector('[data-replay]')!.addEventListener('click', play);
</script>

<style>
  .wa {
    --bg: var(--bWa);
    --prev: var(--bOrders);
    --h: var(--hWa);
  }
  .phone {
    max-width: 420px;
    margin-left: auto;
    border-radius: 22px;
    width: 100%;
  }
  .phone-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: var(--paper);
    padding: 14px 18px;
  }
  .phone-top b {
    font: 800 1rem/1 var(--display);
    font-variation-settings: 'wdth' 110;
  }
  .phone-top .tag {
    color: var(--paper);
  }
  .msgs {
    list-style: none;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    min-height: 380px;
    background-image: radial-gradient(#e3e3d8 1px, transparent 1px);
    background-size: 14px 14px;
  }
  .bub {
    max-width: 82%;
    padding: 9px 12px;
    border-radius: 12px;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .bot {
    align-self: flex-start;
    background: #fff;
    border: 1.5px solid var(--ink);
    border-bottom-left-radius: 3px;
  }
  .me {
    align-self: flex-end;
    background: #c8b8ff;
    border-bottom-right-radius: 3px;
  }
  .file {
    font: 600 0.78rem/1.3 var(--code);
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .clip {
    background: var(--ink);
    color: var(--paper);
    padding: 3px 5px;
    border-radius: 3px;
    font-size: 0.62rem;
  }
  .msgs:global(.play) .bub {
    animation: pop 0.45s var(--out) var(--d) both;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
  }
  .phone-foot {
    padding: 0 16px 16px;
  }
  @media (max-width: 960px) {
    .phone {
      margin-left: 0;
    }
  }
</style>
